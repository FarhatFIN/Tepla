# ═══════════════════════════════════════════
# Tepla Messenger — Environment Variables
# Copy to .env and fill in your values
# ═══════════════════════════════════════════

# ─── Security ─────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string
POSTGRES_PASSWORD=tepla_secret

AUTH_USER_SERVICE_URL=http://localhost:3001
MESSAGING_SERVICE_URL=http://localhost:3003
MEDIA_SERVICE_URL=http://localhost:3007
REALTIME_SERVICE_URL=http://localhost:3100
BOT_PLATFORM_SERVICE_URL=http://localhost:3013

# ─── Twilio (SMS OTP) ────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── Push Notifications (VAPID) ──────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@tepla.app

# ─── Paddle (Payments) ───────────────────
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_ID_MONTHLY=
PADDLE_PRICE_ID_YEARLY=

# ─── Object Storage (MinIO / S3) ─────────
S3_ACCESS_KEY=tepla_minio
S3_SECRET_KEY=tepla_minio_secret
S3_BUCKET=tepla-media
S3_REGION=us-east-1

# ─── CORS ─────────────────────────────────
CORS_ORIGIN=http://localhost:3080

# ─── LiveKit (Voice/Video) ───────────────
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=

# ─── TON Blockchain ──────────────────────
TON_API_KEY=
TON_RPC_ENDPOINT=
TON_WALLET_PUBLIC_KEY=
TON_WALLET_SECRET_KEY=

# ─── AI ──────────────────────────────────
OPENAI_API_KEY=
