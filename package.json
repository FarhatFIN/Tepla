{
  "name": "tepla",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "client",
    "shared/*",
    "services/*",
    "gateway/*"
  ],
  "scripts": {
    "bootstrap": "npm install --workspaces --include-workspace-root",
    "dev": "npm run dev --workspace tepla-client",
    "build": "npm run build --workspace tepla-client",
    "start": "npm run start --workspace tepla-client",
    "lint": "npm run lint --workspace tepla-client",
    "typecheck": "npm run typecheck --workspace tepla-client",
    "test": "npm run test --workspace tepla-client",
    "check": "npm run lint && npm run test && npm run typecheck && npm run build",
    "dev:gateway": "npm run dev --workspace @tepla/api-gateway",
    "dev:auth-user": "npm run dev --workspace @tepla/auth-user-service",
    "dev:messaging": "npm run dev --workspace @tepla/messaging-service",
    "dev:media": "npm run dev --workspace @tepla/media-service",
    "dev:realtime": "npm run dev --workspace @tepla/websocket-gateway",
    "dev:bot": "npm run dev --workspace @tepla/bot-service",
    "stack:core:start": "powershell -ExecutionPolicy Bypass -File scripts/dev/tepla-dev.ps1 -Action StartAll",
    "stack:core:stop": "powershell -ExecutionPolicy Bypass -File scripts/dev/tepla-dev.ps1 -Action StopAll",
    "launcher:open": "mshta.exe tools/launcher/TeplaLauncher.hta",
    "launcher:build": "powershell -ExecutionPolicy Bypass -File tools/launcher/build-launcher.ps1",
    "infra:up": "docker compose -f infrastructure/docker-compose.yml -f infrastructure/docker-compose.dev.yml up -d",
    "infra:down": "docker compose -f infrastructure/docker-compose.yml -f infrastructure/docker-compose.dev.yml down",
    "stack:legacy:up": "docker compose -f infrastructure/docker-compose.legacy.yml up -d",
    "stack:legacy:down": "docker compose -f infrastructure/docker-compose.legacy.yml down",
    "dev:legacy-root": "node server.mts",
    "build:legacy-root": "next build",
    "start:legacy-root": "set NODE_ENV=production&& node server.mts",
    "lint:legacy-root": "next lint",
    "dev:next": "next dev"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1010.0",
    "@aws-sdk/s3-request-presigner": "^3.1010.0",
    "@elastic/elasticsearch": "^9.3.4",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@livekit/components-react": "^2.9.20",
    "@livekit/components-styles": "^1.2.0",
    "@noble/ed25519": "^3.0.1",
    "@noble/hashes": "^2.0.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@socket.io/redis-adapter": "^8.3.0",
    "@stablelib/hkdf": "^2.0.1",
    "@stablelib/random": "^2.0.1",
    "@stablelib/sha256": "^2.0.1",
    "@stablelib/x25519": "^2.0.1",
    "@supabase/auth-helpers-nextjs": "^0.15.0",
    "@supabase/supabase-js": "^2.98.0",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@tanstack/react-query-next-experimental": "^5.91.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/multer": "^2.1.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.70.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "fluent-ffmpeg": "^2.1.3",
    "framer-motion": "^12.35.1",
    "helmet": "^8.1.0",
    "highlight.js": "^11.11.1",
    "http-proxy-middleware": "^3.0.5",
    "ioredis": "^5.10.0",
    "jotai": "^2.18.0",
    "jotai-devtools": "^0.13.0",
    "jsonwebtoken": "^9.0.3",
    "kafkajs": "^2.2.4",
    "libsodium-wrappers": "^0.8.2",
    "livekit-client": "^2.17.2",
    "livekit-server-sdk": "^2.15.0",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.577.0",
    "multer": "^2.1.1",
    "next": "14.2.35",
    "openai": "^6.27.0",
    "pg": "^8.20.0",
    "react": "^18",
    "react-dom": "^18",
    "react-virtuoso": "^4.18.3",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.5.0",
    "tonweb": "^0.0.66",
    "twilio": "^5.12.2",
    "uuid": "^13.0.0",
    "web-push": "^3.6.7",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/web-push": "^3.6.4",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
