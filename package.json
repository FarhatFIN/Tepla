{
  "name": "tepla",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm --prefix client run dev",
    "build": "npm --prefix client run build",
    "start": "npm --prefix client run start",
    "lint": "npm --prefix client run lint",
    "infra:up": "docker compose -f infrastructure/docker-compose.yml -f infrastructure/docker-compose.dev.yml up -d",
    "infra:down": "docker compose -f infrastructure/docker-compose.yml -f infrastructure/docker-compose.dev.yml down",
    "stack:legacy:up": "docker compose -f infrastructure/docker-compose.legacy.yml up -d",
    "stack:legacy:down": "docker compose -f infrastructure/docker-compose.legacy.yml down",
    "dev:legacy-root": "node server.mts",
    "build:legacy-root": "next build",
    "start:legacy-root": "set NODE_ENV=production&& node server.mts",
    "lint:legacy-root": "next lint",
    "dev:next": "next dev",
    "start:api": "npx tsx --tsconfig tsconfig.services.json services/messaging-core-service/src/index.ts",
    "start:outbox-worker": "npx tsx --tsconfig tsconfig.services.json services/workers/outbox-worker/src/index.ts",
    "start:cleanup-worker": "npx tsx --tsconfig tsconfig.services.json services/workers/cleanup-worker/src/index.ts",
    "start:search-worker": "npx tsx --tsconfig tsconfig.services.json services/workers/search-worker/src/index.ts",
    "start:moderation-worker": "npx tsx --tsconfig tsconfig.services.json services/workers/moderation-worker/src/index.ts",
    "start:analytics-worker": "npx tsx --tsconfig tsconfig.services.json services/workers/analytics-worker/src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1010.0",
    "@aws-sdk/lib-storage": "^3.1022.0",
    "@aws-sdk/s3-request-presigner": "^3.1010.0",
    "@elastic/elasticsearch": "^9.3.4",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@livekit/components-react": "^2.9.20",
    "@livekit/components-styles": "^1.2.0",
    "@noble/ed25519": "^3.0.1",
    "@noble/hashes": "^2.0.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@socket.io/redis-adapter": "^8.3.0",
    "@stablelib/hkdf": "^2.0.1",
    "@stablelib/random": "^2.0.1",
    "@stablelib/sha256": "^2.0.1",
    "@stablelib/x25519": "^2.0.1",
    "@supabase/auth-helpers-nextjs": "^0.15.0",
    "@supabase/supabase-js": "^2.98.0",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-query-devtools": "^5.91.3",
    "@tanstack/react-query-next-experimental": "^5.91.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/multer": "^2.1.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.70.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "fluent-ffmpeg": "^2.1.3",
    "framer-motion": "^12.35.1",
    "helmet": "^8.1.0",
    "highlight.js": "^11.11.1",
    "http-proxy-middleware": "^3.0.5",
    "ioredis": "^5.10.0",
    "jotai": "^2.18.0",
    "jotai-devtools": "^0.13.0",
    "jsonwebtoken": "^9.0.3",
    "kafkajs": "^2.2.4",
    "libsodium-wrappers": "^0.8.2",
    "livekit-client": "^2.17.2",
    "livekit-server-sdk": "^2.15.0",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.577.0",
    "multer": "^2.1.1",
    "next": "14.2.35",
    "nodemailer": "^8.0.4",
    "openai": "^6.27.0",
    "pg": "^8.20.0",
    "react": "^18",
    "react-dom": "^18",
    "react-virtuoso": "^4.18.3",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.5.0",
    "tonweb": "^0.0.66",
    "twilio": "^5.12.2",
    "uuid": "^13.0.0",
    "uuidv7": "^1.2.1",
    "web-push": "^3.6.7",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/web-push": "^3.6.4",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.2"
  }
}
