<html>
  <head>
    <title>Tepla Launcher</title>
    <hta:application applicationname="Tepla Launcher" border="thin" caption="yes" contextmenu="no" maximizebutton="yes" minimizebutton="yes" navigable="no" scroll="yes" singleinstance="yes" sysmenu="yes" windowstate="normal" />
    <style>
      * { box-sizing: border-box; }
      body { margin: 0; font-family: "Segoe UI", Arial, sans-serif; background: #07111f; color: #eef5ff; }
      .top { padding: 22px 24px; background: linear-gradient(135deg,#10233d,#0b1729 58%,#112f3a); border-bottom: 1px solid #20344f; }
      .row { display: flex; align-items: center; justify-content: space-between; gap: 16px; }
      h1 { margin: 0; font-size: 28px; }
      .sub { margin: 7px 0 0; color: #a9bdd8; font-size: 13px; }
      .repo { margin-top: 16px; padding: 11px 13px; border: 1px solid #274260; border-radius: 10px; background: rgba(255,255,255,.05); color: #d9e8fb; word-break: break-all; }
      .actions { display: flex; flex-wrap: wrap; gap: 8px; }
      button { border: 1px solid #2c4665; border-radius: 9px; padding: 10px 12px; background: #13243b; color: #eef5ff; cursor: pointer; font-weight: 600; }
      button:hover { background: #193150; }
      button.primary { background: #1c72d8; border-color: #3690ff; }
      button.danger { background: #6d2634; border-color: #a54155; }
      button.small { padding: 7px 9px; font-size: 12px; }
      .main { padding: 18px 24px 24px; }
      .grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; }
      .card { border: 1px solid #223953; border-radius: 10px; background: #0d1a2c; padding: 13px; min-height: 116px; }
      .card-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 9px; }
      .name { font-size: 15px; font-weight: 700; }
      .meta { color: #8fa8c8; font-size: 12px; line-height: 1.45; min-height: 34px; }
      .dot { display: inline-block; width: 9px; height: 9px; border-radius: 50%; margin-right: 6px; background: #6c7b8f; }
      .on { background: #24d17e; box-shadow: 0 0 10px rgba(36,209,126,.7); }
      .off { background: #7b8797; }
      .card-actions { margin-top: 12px; display: flex; gap: 7px; flex-wrap: wrap; }
      .log { margin-top: 16px; border: 1px solid #223953; border-radius: 10px; background: #050b14; padding: 12px; color: #9fb5d1; font-family: Consolas, monospace; font-size: 12px; height: 92px; overflow: auto; white-space: pre-wrap; }
      .hint { margin-top: 10px; color: #8199b8; font-size: 12px; }
      @media (max-width: 760px) { .grid { grid-template-columns: 1fr; } .row { align-items: flex-start; flex-direction: column; } }
    </style>
    <script language="javascript">
      function shell() { return new ActiveXObject("WScript.Shell"); }
      function fso() { return new ActiveXObject("Scripting.FileSystemObject"); }
      function launcherDir() {
        var raw = decodeURIComponent(document.location.pathname).replace(/\//g, "\\");
        if (raw.charAt(0) === "\\") raw = raw.substring(1);
        return fso().GetParentFolderName(raw);
      }
      function scriptPath() {
        var fs = fso();
        var local = fs.BuildPath(launcherDir(), "tepla-dev.ps1");
        if (fs.FileExists(local)) return local;
        return fs.BuildPath(launcherDir(), "..\\..\\scripts\\dev\\tepla-dev.ps1");
      }
      function psBase(action, serviceId) {
        var cmd = 'powershell.exe -NoProfile -ExecutionPolicy Bypass -File "' + scriptPath() + '" -Action ' + action;
        if (serviceId) cmd += ' -ServiceId "' + serviceId + '"';
        return cmd;
      }
      function log(text) {
        var box = document.getElementById("log");
        box.innerText = new Date().toLocaleTimeString() + "  " + text + "\n" + box.innerText;
      }
      function runAction(action, serviceId, visible) {
        try {
          shell().Run(psBase(action, serviceId), visible ? 1 : 0, false);
          log((serviceId ? serviceId + ": " : "") + action + " started");
          setTimeout(refreshStatus, 900);
        } catch (err) { log("ERROR: " + err.message); }
      }
      function refreshStatus() {
        try {
          var exec = shell().Exec(psBase("GetStatus"));
          var raw = exec.StdOut.ReadAll();
          var state = JSON.parse(raw || "{}");
          document.getElementById("repo-root").innerText = state.repoRoot || "Select repository";
          renderServices(state.services || []);
        } catch (err) { log("Status failed: " + err.message); }
      }
      function renderServices(services) {
        var html = "";
        for (var i = 0; i < services.length; i++) {
          var s = services[i];
          html += '<div class="card"><div class="card-head"><div class="name"><span class="dot ' + (s.running ? 'on' : 'off') + '"></span>' + s.name + '</div><div>' + (s.running ? 'PID ' + s.pid : 'stopped') + '</div></div>';
          html += '<div class="meta">' + (s.port ? 'Port ' + s.port + '<br>' : '') + s.command + '</div>';
          html += '<div class="card-actions"><button class="small primary" onclick="runAction(\'StartService\',\'' + s.id + '\',true)">Start</button><button class="small danger" onclick="runAction(\'StopService\',\'' + s.id + '\',false)">Stop</button></div></div>';
        }
        document.getElementById("services").innerHTML = html;
      }
      window.onload = function() { window.resizeTo(980, 720); refreshStatus(); setInterval(refreshStatus, 5000); };
    </script>
  </head>
  <body>
    <div class="top">
      <div class="row">
        <div><h1>Tepla Launcher</h1><p class="sub">UI for infra, backend services, client, bot platform, health, and repo selection.</p></div>
        <div class="actions">
          <button onclick="runAction('SelectRepo',null,true)">Select Repo</button>
          <button class="primary" onclick="runAction('StartAll',null,true)">Start All</button>
          <button onclick="runAction('StartInfra',null,true)">Infra</button>
          <button onclick="runAction('StartCore',null,true)">Core</button>
          <button onclick="runAction('StartClient',null,true)">Client UI</button>
          <button onclick="runAction('StartBot',null,true)">Bot</button>
          <button onclick="runAction('OpenApp')">Open UI</button>
          <button onclick="runAction('OpenHealth')">Health</button>
          <button class="danger" onclick="runAction('StopAll')">Stop All</button>
        </div>
      </div>
      <div class="repo"><b>Repo:</b> <span id="repo-root">Loading...</span></div>
    </div>
    <div class="main">
      <div id="services" class="grid"></div>
      <div id="log" class="log">Launcher ready.</div>
      <div class="hint">Start opens service consoles so errors are visible. Status refreshes every 5 seconds.</div>
    </div>
  </body>
</html>